<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Security Demo</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0f0f23;
            min-height: 100vh;
            color: #fff;
        }

        .header {
            background: linear-gradient(135deg, #1a1a3e 0%, #2d2d5a 100%);
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .header h1 {
            font-size: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
        }

        .btn-danger {
            background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
            color: #fff;
        }

        .btn-success {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: #fff;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
        }

        .main-content {
            padding: 30px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-card .icon {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .stat-card .value {
            font-size: 36px;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-card .label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            margin-top: 5px;
        }

        .demo-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .demo-status.active {
            background: rgba(40, 167, 69, 0.2);
            color: #38ef7d;
        }

        .demo-status.inactive {
            background: rgba(220, 53, 69, 0.2);
            color: #ff6b6b;
        }

        .demo-status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .demo-status.active .dot {
            background: #38ef7d;
        }

        .demo-status.inactive .dot {
            background: #ff6b6b;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .section-title {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .data-grid {
            display: grid;
            gap: 20px;
        }

        .visitor-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            overflow: hidden;
        }

        .visitor-header {
            background: rgba(102, 126, 234, 0.1);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .visitor-id {
            font-weight: 600;
            color: #667eea;
        }

        .visitor-time {
            color: rgba(255, 255, 255, 0.5);
            font-size: 12px;
        }

        .visitor-body {
            padding: 20px;
        }

        .data-section {
            margin-bottom: 20px;
        }

        .data-section:last-child {
            margin-bottom: 0;
        }

        .data-section h4 {
            color: rgba(255, 255, 255, 0.8);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .data-row {
            display: flex;
            padding: 8px 12px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 6px;
            margin-bottom: 5px;
            font-size: 13px;
        }

        .data-row .label {
            color: rgba(255, 255, 255, 0.5);
            width: 140px;
            flex-shrink: 0;
        }

        .data-row .value {
            color: #fff;
            word-break: break-all;
        }

        .permission-badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .permission-granted {
            background: rgba(40, 167, 69, 0.2);
            color: #38ef7d;
        }

        .permission-denied {
            background: rgba(220, 53, 69, 0.2);
            color: #ff6b6b;
        }

        .permission-pending {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
        }

        .snapshots-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .snapshot-img {
            width: 100%;
            border-radius: 8px;
            border: 2px solid rgba(255, 255, 255, 0.1);
        }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.5);
        }

        .no-data .icon {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        .location-link {
            color: #667eea;
            text-decoration: none;
        }

        .location-link:hover {
            text-decoration: underline;
        }

        .refresh-indicator {
            display: none;
            position: fixed;
            top: 80px;
            right: 30px;
            background: rgba(102, 126, 234, 0.9);
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 13px;
        }

        /* Tab Navigation */
        .tab-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 10px;
        }

        .tab-btn {
            padding: 10px 20px;
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 8px 8px 0 0;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
        }

        .tab-btn.active {
            color: #667eea;
            background: rgba(102, 126, 234, 0.1);
            border-bottom: 2px solid #667eea;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Timeline Styles */
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 10px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, #667eea, #764ba2);
        }

        .timeline-item {
            position: relative;
            padding: 15px 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            margin-bottom: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -24px;
            top: 20px;
            width: 12px;
            height: 12px;
            background: #667eea;
            border-radius: 50%;
            border: 2px solid #0f0f23;
        }

        .timeline-item.permission-event::before {
            background: #38ef7d;
        }

        .timeline-item.denied-event::before {
            background: #ff6b6b;
        }

        .timeline-time {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            margin-bottom: 5px;
        }

        .timeline-title {
            font-weight: 600;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .timeline-details {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.6);
        }

        /* JSON Viewer Styles */
        .json-container {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .json-toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .json-viewer {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 8px;
            padding: 20px;
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
            font-size: 12px;
            line-height: 1.6;
            overflow-x: auto;
            max-height: 600px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }

        .json-key { color: #f8c555; }
        .json-string { color: #98c379; }
        .json-number { color: #d19a66; }
        .json-boolean { color: #56b6c2; }
        .json-null { color: #c678dd; }

        /* Export Button */
        .export-btn {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>
            🛡️ Security Demo Dashboard
            <span class="demo-status <%= demoActive ? 'active' : 'inactive' %>" id="demoStatus">
                <span class="dot"></span>
                <span id="statusText"><%= demoActive ? 'Demo Active' : 'Demo Stopped' %></span>
            </span>
        </h1>
        <div class="header-actions">
            <button class="btn btn-secondary" onclick="refreshData()">
                🔄 Refresh
            </button>
            <button class="btn <%= demoActive ? 'btn-danger' : 'btn-success' %>" id="toggleBtn" onclick="toggleDemo()">
                <%= demoActive ? '⏹️ Stop Demo' : '▶️ Start Demo' %>
            </button>
            <button class="btn btn-danger" onclick="clearData()">
                🗑️ Clear Data
            </button>
            <a href="/admin/logout" class="btn btn-secondary">
                🚪 Logout
            </a>
        </div>
    </div>

    <div class="main-content">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="icon">👥</div>
                <div class="value" id="totalVisitors"><%= totalVisitors %></div>
                <div class="label">Total Visitors</div>
            </div>
            <div class="stat-card">
                <div class="icon">📷</div>
                <div class="value" id="cameraGranted"><%= data.filter(d => d.permissions?.camera === 'granted').length %></div>
                <div class="label">Camera Granted</div>
            </div>
            <div class="stat-card">
                <div class="icon">📍</div>
                <div class="value" id="locationGranted"><%= data.filter(d => d.permissions?.location === 'granted').length %></div>
                <div class="label">Location Granted</div>
            </div>
            <div class="stat-card">
                <div class="icon">🎤</div>
                <div class="value" id="micGranted"><%= data.filter(d => d.permissions?.microphone === 'granted').length %></div>
                <div class="label">Microphone Granted</div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-nav">
            <button class="tab-btn active" onclick="showTab('cards')">📊 Card View</button>
            <button class="tab-btn" onclick="showTab('timeline')">📅 Timeline</button>
            <button class="tab-btn" onclick="showTab('json')">{ } JSON Data</button>
        </div>

        <!-- Card View Tab -->
        <div class="tab-content active" id="cards-tab">
        <h2 class="section-title">📊 Collected Data</h2>

        <div class="data-grid" id="dataGrid">
            <% if (data.length === 0) { %>
                <div class="no-data">
                    <div class="icon">📭</div>
                    <h3>No Data Collected Yet</h3>
                    <p>Share the demo link with students to start collecting data</p>
                </div>
            <% } else { %>
                <% data.slice().reverse().forEach((visitor, index) => { %>
                    <div class="visitor-card">
                        <div class="visitor-header">
                            <span class="visitor-id">Visitor #<%= data.length - index %> - <%= visitor.ip %></span>
                            <span class="visitor-time"><%= new Date(visitor.timestamp).toLocaleString() %></span>
                        </div>
                        <div class="visitor-body">
                            <!-- Permissions -->
                            <div class="data-section">
                                <h4>🔐 Permissions</h4>
                                <div class="data-row">
                                    <span class="label">Camera:</span>
                                    <span class="permission-badge permission-<%= visitor.permissions?.camera || 'pending' %>">
                                        <%= visitor.permissions?.camera || 'pending' %>
                                    </span>
                                </div>
                                <div class="data-row">
                                    <span class="label">Microphone:</span>
                                    <span class="permission-badge permission-<%= visitor.permissions?.microphone || 'pending' %>">
                                        <%= visitor.permissions?.microphone || 'pending' %>
                                    </span>
                                </div>
                                <div class="data-row">
                                    <span class="label">Location:</span>
                                    <span class="permission-badge permission-<%= visitor.permissions?.location || 'pending' %>">
                                        <%= visitor.permissions?.location || 'pending' %>
                                    </span>
                                </div>
                            </div>

                            <!-- Location Data -->
                            <% if (visitor.location) { %>
                                <div class="data-section">
                                    <h4>📍 Location</h4>
                                    <div class="data-row">
                                        <span class="label">Coordinates:</span>
                                        <span class="value">
                                            <a class="location-link" href="https://www.google.com/maps?q=<%= visitor.location.latitude %>,<%= visitor.location.longitude %>" target="_blank">
                                                <%= visitor.location.latitude.toFixed(6) %>, <%= visitor.location.longitude.toFixed(6) %>
                                            </a>
                                        </span>
                                    </div>
                                    <div class="data-row">
                                        <span class="label">Accuracy:</span>
                                        <span class="value"><%= visitor.location.accuracy ? visitor.location.accuracy.toFixed(0) + ' meters' : 'N/A' %></span>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Device Info -->
                            <% if (visitor.deviceInfo) { %>
                                <div class="data-section">
                                    <h4>💻 Device Information</h4>
                                    <div class="data-row">
                                        <span class="label">Platform:</span>
                                        <span class="value"><%= visitor.deviceInfo.platform %></span>
                                    </div>
                                    <div class="data-row">
                                        <span class="label">Language:</span>
                                        <span class="value"><%= visitor.deviceInfo.language %></span>
                                    </div>
                                    <div class="data-row">
                                        <span class="label">Screen:</span>
                                        <span class="value"><%= visitor.deviceInfo.screenWidth %>x<%= visitor.deviceInfo.screenHeight %></span>
                                    </div>
                                    <div class="data-row">
                                        <span class="label">CPU Cores:</span>
                                        <span class="value"><%= visitor.deviceInfo.hardwareConcurrency %></span>
                                    </div>
                                    <div class="data-row">
                                        <span class="label">Memory:</span>
                                        <span class="value"><%= visitor.deviceInfo.deviceMemory %> GB</span>
                                    </div>
                                    <div class="data-row">
                                        <span class="label">Timezone:</span>
                                        <span class="value"><%= visitor.deviceInfo.timezone %></span>
                                    </div>
                                    <% if (visitor.deviceInfo.network) { %>
                                        <div class="data-row">
                                            <span class="label">Connection:</span>
                                            <span class="value"><%= visitor.deviceInfo.network.effectiveType %> (<%= visitor.deviceInfo.network.downlink %> Mbps)</span>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="data-section">
                                    <h4>🌐 User Agent</h4>
                                    <div class="data-row">
                                        <span class="value" style="font-size: 11px;"><%= visitor.deviceInfo.userAgent %></span>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Camera Snapshots -->
                            <% if (visitor.snapshots && visitor.snapshots.length > 0) { %>
                                <div class="data-section">
                                    <h4>📷 Camera Snapshots (<%= visitor.snapshots.length %>)</h4>
                                    <div class="snapshots-grid">
                                        <% visitor.snapshots.forEach(snap => { %>
                                            <img class="snapshot-img" src="<%= snap.image %>" alt="Snapshot">
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
        </div>

        <!-- Timeline Tab -->
        <div class="tab-content" id="timeline-tab">
            <h2 class="section-title">📅 Activity Timeline</h2>
            <% if (data.length === 0) { %>
                <div class="no-data">
                    <div class="icon">📭</div>
                    <h3>No Activity Yet</h3>
                    <p>Events will appear here as visitors interact with the demo</p>
                </div>
            <% } else { %>
                <div class="timeline">
                    <%
                    // Build timeline events from all visitors
                    let timelineEvents = [];
                    data.forEach((visitor, idx) => {
                        // Visit event
                        timelineEvents.push({
                            time: visitor.timestamp,
                            type: 'visit',
                            icon: '👤',
                            title: 'New Visitor',
                            details: `IP: ${visitor.ip} | ${visitor.deviceInfo?.platform || 'Unknown'}`,
                            visitorId: visitor.visitorId
                        });

                        // Permission events
                        if (visitor.permissions?.camera === 'granted') {
                            timelineEvents.push({
                                time: visitor.timestamp,
                                type: 'permission',
                                icon: '📷',
                                title: 'Camera Access Granted',
                                details: `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                        if (visitor.permissions?.camera === 'denied') {
                            timelineEvents.push({
                                time: visitor.timestamp,
                                type: 'denied',
                                icon: '📷',
                                title: 'Camera Access Denied',
                                details: `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                        if (visitor.permissions?.microphone === 'granted') {
                            timelineEvents.push({
                                time: visitor.timestamp,
                                type: 'permission',
                                icon: '🎤',
                                title: 'Microphone Access Granted',
                                details: `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                        if (visitor.permissions?.microphone === 'denied') {
                            timelineEvents.push({
                                time: visitor.timestamp,
                                type: 'denied',
                                icon: '🎤',
                                title: 'Microphone Access Denied',
                                details: `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                        if (visitor.permissions?.location === 'granted') {
                            timelineEvents.push({
                                time: visitor.timestamp,
                                type: 'permission',
                                icon: '📍',
                                title: 'Location Access Granted',
                                details: visitor.location ? `${visitor.location.latitude.toFixed(4)}, ${visitor.location.longitude.toFixed(4)}` : `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                        if (visitor.permissions?.location === 'denied') {
                            timelineEvents.push({
                                time: visitor.timestamp,
                                type: 'denied',
                                icon: '📍',
                                title: 'Location Access Denied',
                                details: `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                        if (visitor.snapshots && visitor.snapshots.length > 0) {
                            timelineEvents.push({
                                time: visitor.snapshots[0].time || visitor.timestamp,
                                type: 'permission',
                                icon: '🖼️',
                                title: `${visitor.snapshots.length} Snapshot(s) Captured`,
                                details: `Visitor ${visitor.ip}`,
                                visitorId: visitor.visitorId
                            });
                        }
                    });

                    // Sort by time descending
                    timelineEvents.sort((a, b) => new Date(b.time) - new Date(a.time));
                    %>
                    <% timelineEvents.forEach(event => { %>
                        <div class="timeline-item <%= event.type === 'permission' ? 'permission-event' : (event.type === 'denied' ? 'denied-event' : '') %>">
                            <div class="timeline-time"><%= new Date(event.time).toLocaleString() %></div>
                            <div class="timeline-title">
                                <span><%= event.icon %></span>
                                <span><%= event.title %></span>
                            </div>
                            <div class="timeline-details"><%= event.details %></div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- JSON Tab -->
        <div class="tab-content" id="json-tab">
            <h2 class="section-title">{ } Raw JSON Data</h2>
            <div class="json-container">
                <div class="json-toolbar">
                    <button class="btn export-btn" onclick="exportJSON()">📥 Export JSON</button>
                    <button class="btn btn-secondary" onclick="copyJSON()">📋 Copy to Clipboard</button>
                </div>
                <div class="json-viewer" id="jsonViewer">
                    <pre id="jsonContent"><%= JSON.stringify(data, null, 2) %></pre>
                </div>
            </div>
        </div>
    </div>

    <div class="refresh-indicator" id="refreshIndicator">
        Refreshing data...
    </div>

    <script>
        let demoActive = <%= demoActive %>;

        async function toggleDemo() {
            const response = await fetch('/admin/toggle-demo', { method: 'POST' });
            const result = await response.json();
            demoActive = result.active;

            const status = document.getElementById('demoStatus');
            const statusText = document.getElementById('statusText');
            const toggleBtn = document.getElementById('toggleBtn');

            status.className = 'demo-status ' + (demoActive ? 'active' : 'inactive');
            statusText.textContent = demoActive ? 'Demo Active' : 'Demo Stopped';
            toggleBtn.className = 'btn ' + (demoActive ? 'btn-danger' : 'btn-success');
            toggleBtn.innerHTML = demoActive ? '⏹️ Stop Demo' : '▶️ Start Demo';
        }

        async function clearData() {
            if (!confirm('Are you sure you want to clear all collected data?')) return;

            const response = await fetch('/admin/clear-data', { method: 'POST' });
            const result = await response.json();

            if (result.success) {
                alert(`Cleared ${result.cleared} records`);
                location.reload();
            }
        }

        async function refreshData() {
            document.getElementById('refreshIndicator').style.display = 'block';

            try {
                const response = await fetch('/admin/api/data');
                const result = await response.json();

                document.getElementById('totalVisitors').textContent = result.totalVisitors;
                document.getElementById('cameraGranted').textContent =
                    result.data.filter(d => d.permissions?.camera === 'granted').length;
                document.getElementById('locationGranted').textContent =
                    result.data.filter(d => d.permissions?.location === 'granted').length;
                document.getElementById('micGranted').textContent =
                    result.data.filter(d => d.permissions?.microphone === 'granted').length;

                // Reload page to update the full grid (simpler than rebuilding DOM)
                if (result.totalVisitors !== <%= totalVisitors %>) {
                    location.reload();
                }
            } catch (e) {
                console.error('Refresh failed:', e);
            }

            document.getElementById('refreshIndicator').style.display = 'none';
        }

        // Auto-refresh every 10 seconds
        setInterval(refreshData, 10000);

        // Tab switching
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            // Show selected tab
            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
        }

        // Export JSON
        function exportJSON() {
            const data = <%- JSON.stringify(data) %>;
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'security-demo-data-' + new Date().toISOString().slice(0, 10) + '.json';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Copy JSON to clipboard
        function copyJSON() {
            const data = <%- JSON.stringify(data) %>;
            const jsonText = JSON.stringify(data, null, 2);
            navigator.clipboard.writeText(jsonText).then(() => {
                alert('JSON copied to clipboard!');
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        }

        // Syntax highlight JSON (optional enhancement)
        function highlightJSON() {
            const pre = document.getElementById('jsonContent');
            if (pre) {
                let json = pre.textContent;
                json = json.replace(/"([^"]+)":/g, '<span class="json-key">"$1"</span>:');
                json = json.replace(/: "([^"]+)"/g, ': <span class="json-string">"$1"</span>');
                json = json.replace(/: (\d+)/g, ': <span class="json-number">$1</span>');
                json = json.replace(/: (true|false)/g, ': <span class="json-boolean">$1</span>');
                json = json.replace(/: (null)/g, ': <span class="json-null">$1</span>');
                pre.innerHTML = json;
            }
        }

        // Initialize
        highlightJSON();
    </script>
</body>
</html>
